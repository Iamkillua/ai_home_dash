# Copy to .env. Keep secrets on the server, never in the browser or source control.
DEMO_MODE=true
# Required when DEMO_MODE=false. Enter this token in Dashboard > Connections.
DASHBOARD_TOKEN=
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
# Optional comma-separated entity allowlist; empty exposes supported entities.
HOME_ASSISTANT_ENTITIES=
MEDIA_PLAYER_ENTITY=media_player.living_room
# JSON mapping of genres to Home Assistant media-source IDs or playable URLs.
MUSIC_LIBRARY={"jazz":"media-source://media_source/local/jazz.mp3"}
DOCKER_HOST=
CONTAINER_CONTROL_ENABLED=false
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_LOCATION=Home
RSS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://www.nasa.gov/rss/dyn/breaking_news.rss,https://news.google.com/rss?hl=en-US&gl=US&ceid=US:en
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Set to a Gemini Live native-audio model available to your account.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
VOICE_ENABLED=false
PICOVOICE_ACCESS_KEY=
# Custom Jarvis .ppn model for the target Raspberry Pi platform.
PORCUPINE_MODEL_PATH=
# -1 uses the default input device.
AUDIO_DEVICE_INDEX=-1
VOICE_STT=google
# When VOICE_STT=whisper, install SpeechRecognition[whisper-local] separately.
WHISPER_MODEL=base
VOICE_SESSION_SECONDS=60
# Piper is used for browser replies and local Pi voice fallback.
TTS_ENGINE=piper
PIPER_MODEL_PATH=models/en_GB-northern_english_male-medium.onnx
# Docker model filename stem (PIPER_MODEL_PATH is set to /models inside Compose).
PIPER_VOICE=en_GB-northern_english_male-medium
# >1 slightly slower speech; keep between 0.5 and 2.
PIPER_LENGTH_SCALE=1.05
# Set automatically by Compose. Container telemetry is labeled separately.
JARVIS_CONTAINER=false
# Docker host-side binding; use an HTTPS proxy for LAN access.
JARVIS_BIND_ADDRESS=127.0.0.1
JARVIS_PORT=8000
# Pi audio override only: set to the numeric group ID from `getent group audio`.
# AUDIO_GID=29
